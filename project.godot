; Engine configuration file.
config_version=5

[application]

config/name="Ethan's Skate Odyssey"
config/description="Cartoon 2D skateboarding adventure - Stage 1 prototype."
run/main_scene="res://scenes/ui/splash_screen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/systems/game_state.gd"
Music="*res://scripts/systems/music_player.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="hazard"
2d_physics/layer_4="rail"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
